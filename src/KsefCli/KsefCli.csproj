<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ksef</AssemblyName>
    <RootNamespace>KsefCli</RootNamespace>
    <!-- Analizatory trimmingu/AOT przy każdym buildzie. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Refleksja w naszym kodzie to błąd kompilacji. Nie przy publikacji AOT: tam analiza całego programu
       zgłasza też znane miejsca w bibliotece MF, obsłużone w KsefJson, XmlDsigAlgorithms i ILLink.Descriptors.xml. -->
  <PropertyGroup Condition="'$(KsefAot)' != 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2075;IL3050</WarningsAsErrors>
  </PropertyGroup>

  <!-- Native AOT: make aot (dotnet publish -p:KsefAot=true). Własna właściwość zamiast PublishAot
       z wiersza poleceń, bo ta trafiałaby też do bibliotek MF dla netstandard2.0 (NETSDK1207). -->
  <PropertyGroup Condition="'$(KsefAot)' == 'true'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- XmlSerializer żądania logowania (AuthenticationTokenRequest) czyta model przez refleksję. -->
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
    <!-- KSeF.Client 2.9.0 ciągnie 10.0.10 z lukami DoS (CVE-2026-96958/96959/96960, -84008, -70162; poprawione w 10.0.13).
         Usunąć, gdy biblioteka MF podbije zależności. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ksef.Fa3\Ksef.Fa3.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Oficjalna biblioteka MF budowana ze źródeł (submoduł przypięty do tagu wydania). -->
    <ProjectReference Include="..\..\external\ksef-client-csharp\KSeF.Client\KSeF.Client.csproj" />
  </ItemGroup>

</Project>
