  <ItemGroup>
    <ProjectReference Include="..\..\src\Ksef.Fa3\Ksef.Fa3.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Przykładowe faktury MF z submodułu biblioteki (wersja zgodna z przypiętym tagiem). -->
